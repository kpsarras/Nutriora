<Window x:Class="Nutriora.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nutriora — Nutrition &amp; Fitness" Width="1320" Height="860" MinWidth="980" MinHeight="680" Background="{DynamicResource BackgroundBrush}" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#252B32" CornerRadius="0,24,24,0">
<StackPanel Margin="14,24">
<TextBlock Text="✿" FontWeight="Bold" FontSize="32" Foreground="#BFE6A0" HorizontalAlignment="Center" Margin="0,0,0,35"/>
<Button x:Name="NavDashboard" Content="⌂" FontSize="23" ToolTip="Dashboard" Click="Dashboard_Click"/>
<Button x:Name="NavDiary" Content="☷" FontSize="23" ToolTip="Ημερολόγιο" Click="Diary_Click" Margin="0,14,0,0"/>
<Button x:Name="NavReports" Content="▥" FontSize="23" ToolTip="Αναφορές και στατιστικά" Click="Reports_Click" Margin="0,14,0,0"/><Button x:Name="NavFoods" Content="▦" FontSize="23" ToolTip="Βιβλιοθήκη τροφίμων" Click="Foods_Click" Margin="0,14,0,0"/><Button x:Name="NavProfiles" Content="◉" FontSize="23" ToolTip="Προφίλ και στόχοι" Click="Profiles_Click" Margin="0,14,0,0"/><Button x:Name="NavWeight" Content="⚖" FontSize="23" ToolTip="Βάρος" Click="Weight_Click" Margin="0,14,0,0"/><Button Content="☼" FontSize="23" ToolTip="Εναλλαγή θέματος" Click="Theme_Click" Margin="0,14,0,0"/>
</StackPanel>
</Border>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
<StackPanel Margin="30,26">
<DockPanel Margin="0,0,0,20">
<TextBlock x:Name="PageTitle" Text="Η σημερινή σου εικόνα" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
<TextBlock Text="Nutriora · v0.2.0" Foreground="#60786F" HorizontalAlignment="Right" VerticalAlignment="Center"/>
</DockPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,0,18">
<TextBlock Text="Προφίλ:" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}" Margin="0,0,10,0"/>
<ComboBox x:Name="ProfilePicker" Width="200" DisplayMemberPath="Name" SelectionChanged="Profile_Changed"/>
<TextBlock Text="Ημερομηνία:" Margin="22,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}"/>
<Button Content="‹" ToolTip="Προηγούμενη ημέρα" Click="PreviousDay_Click" Margin="8,0,5,0" MinWidth="32"/><DatePicker x:Name="DayPicker" SelectedDateChanged="Day_Changed"/><Button Content="›" ToolTip="Επόμενη ημέρα" Click="NextDay_Click" Margin="5,0,5,0" MinWidth="32"/><Button Content="Σήμερα" ToolTip="Μετάβαση στη σημερινή ημερομηνία" Click="Today_Click" Margin="0,0,0,0"/>
</StackPanel>
<Grid x:Name="DashboardPanel">
<Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Margin="0,0,10,0">
<Border Background="{DynamicResource HeroBrush}" CornerRadius="24" Padding="24" Margin="0,0,0,14" MinHeight="150" BorderBrush="{DynamicResource HeroBorderBrush}" BorderThickness="1">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel VerticalAlignment="Center"><TextBlock Text="Κάθε μέρα, ένα βήμα μπροστά." FontSize="26" FontWeight="Bold" Foreground="#27342A" TextWrapping="Wrap"/><TextBlock Text="Παρακολούθησε θερμίδες, γεύματα και νερό σε μία οθόνη." FontSize="14" Foreground="#455A43" Margin="0,9,0,0"/><Button Content="+ Καταχώριση γεύματος" Click="QuickEntry_Click" Background="#248C76" Foreground="White" HorizontalAlignment="Left" Margin="0,15,0,0"/></StackPanel>
<TextBlock Grid.Column="1" Text="🥗" FontSize="56" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid></Border>
<Border Background="{DynamicResource ActivityBrush}" CornerRadius="24" Padding="22" Margin="0,0,0,14" Height="186" BorderBrush="{DynamicResource ActivityBorderBrush}" BorderThickness="1">
<StackPanel><TextBlock Text="Δραστηριότητα ημέρας" FontSize="20" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="Θερμίδες ανά καταχώριση (kcal)" Foreground="#AFC0BB" Margin="0,8,0,10"/><TextBlock x:Name="ActivitySummary" FontSize="21" Foreground="#CDEB83" FontWeight="SemiBold"/><Canvas x:Name="ActivityChart" Height="54" Margin="0,8,0,0" Background="Transparent" SizeChanged="ActivityChart_SizeChanged"/></StackPanel></Border>
<Border Background="{DynamicResource PanelBrush}" CornerRadius="22" Padding="22" Margin="0,0,0,14" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
<StackPanel><TextBlock Text="Σύνοψη διατροφής" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/><TextBlock x:Name="CaloriesText" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,10,0,8"/><ProgressBar x:Name="CaloriesProgress" Height="9" Minimum="0" Maximum="100" Margin="0,0,0,10"/><TextBlock x:Name="MacroText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
<UniformGrid Columns="3"><Border Background="#D8F0F8" CornerRadius="14" Padding="12" Margin="0,0,6,0"><StackPanel><TextBlock Text="Υδατάνθρακες" FontSize="11" Foreground="#33434A"/><TextBlock x:Name="CarbValue" FontSize="20" FontWeight="Bold" Foreground="#273A45"/></StackPanel></Border><Border Background="#FFF0C8" CornerRadius="14" Padding="12" Margin="3,0"><StackPanel><TextBlock Text="Πρωτεΐνη" FontSize="11" Foreground="#5B4B27"/><TextBlock x:Name="ProteinValue" FontSize="20" FontWeight="Bold" Foreground="#5B4B27"/></StackPanel></Border><Border Background="#E3F4C6" CornerRadius="14" Padding="12" Margin="6,0,0,0"><StackPanel><TextBlock Text="Λίπος" FontSize="11" Foreground="#35553C"/><TextBlock x:Name="FatValue" FontSize="20" FontWeight="Bold" Foreground="#35553C"/></StackPanel></Border></UniformGrid></StackPanel></Border>
<Border Background="{DynamicResource PanelBrush}" CornerRadius="22" Padding="22" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"><StackPanel>
<TextBlock Text="Τα γεύματά σου" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,10"/>
<UniformGrid Columns="4"><Border Background="{DynamicResource BreakfastBrush}" BorderBrush="#B9E1E9" BorderThickness="1" CornerRadius="16" Padding="12" Margin="4"><StackPanel><TextBlock Text="🥣" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6"/><TextBlock Text="Πρωινό" FontSize="13" FontWeight="SemiBold" Foreground="#29463F" HorizontalAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="BreakfastCalories" FontSize="19" FontWeight="Bold" Foreground="#29463F" HorizontalAlignment="Center" Margin="0,8,0,6"/><Button Content="+ Προσθήκη" Tag="Πρωινό" Click="MealQuickAdd_Click" FontSize="11" Padding="7,4" HorizontalAlignment="Center"/></StackPanel></Border><Border Background="{DynamicResource LunchBrush}" BorderBrush="#D2E9AC" BorderThickness="1" CornerRadius="16" Padding="12" Margin="4"><StackPanel><TextBlock Text="🥗" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6"/><TextBlock Text="Μεσημεριανό" FontSize="13" FontWeight="SemiBold" Foreground="#29463F" HorizontalAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="LunchCalories" FontSize="19" FontWeight="Bold" Foreground="#29463F" HorizontalAlignment="Center" Margin="0,8,0,6"/><Button Content="+ Προσθήκη" Tag="Μεσημεριανό" Click="MealQuickAdd_Click" FontSize="11" Padding="7,4" HorizontalAlignment="Center"/></StackPanel></Border><Border Background="{DynamicResource DinnerBrush}" BorderBrush="#EED9C4" BorderThickness="1" CornerRadius="16" Padding="12" Margin="4"><StackPanel><TextBlock Text="🍲" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6"/><TextBlock Text="Βραδινό" FontSize="13" FontWeight="SemiBold" Foreground="#29463F" HorizontalAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="DinnerCalories" FontSize="19" FontWeight="Bold" Foreground="#29463F" HorizontalAlignment="Center" Margin="0,8,0,6"/><Button Content="+ Προσθήκη" Tag="Βραδινό" Click="MealQuickAdd_Click" FontSize="11" Padding="7,4" HorizontalAlignment="Center"/></StackPanel></Border><Border Background="{DynamicResource SnackBrush}" BorderBrush="#D9C8EC" BorderThickness="1" CornerRadius="16" Padding="12" Margin="4"><StackPanel><TextBlock Text="🍎" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6"/><TextBlock Text="Σνακ" FontSize="13" FontWeight="SemiBold" Foreground="#29463F" HorizontalAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="SnackCalories" FontSize="19" FontWeight="Bold" Foreground="#29463F" HorizontalAlignment="Center" Margin="0,8,0,6"/><Button Content="+ Προσθήκη" Tag="Δεκατιανό" Click="MealQuickAdd_Click" FontSize="11" Padding="7,4" HorizontalAlignment="Center"/></StackPanel></Border></UniformGrid>
<TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
<Button Content="+ Προσθήκη τροφίμου" Click="QuickEntry_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
</StackPanel>
<StackPanel Grid.Column="1" Margin="10,0,0,0">
<Border Background="{DynamicResource PanelBrush}" CornerRadius="24" Padding="22" Margin="0,0,0,14" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
<StackPanel><TextBlock Text="Πρόοδος θερμίδων" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
<Grid Width="190" Height="190" HorizontalAlignment="Center" Margin="0,12"><Ellipse Stroke="#E1E9D9" StrokeThickness="18" Margin="15"/><Path x:Name="BudgetArc" Stroke="#A2D8B6" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="BudgetPercentText" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center"/><TextBlock Text="ημερήσιος στόχος" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Grid>
<ProgressBar x:Name="BudgetProgress" Minimum="0" Maximum="100" Height="7" Visibility="Collapsed"/><TextBlock x:Name="BudgetRemainingText" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/></StackPanel></Border>
<Border Background="{DynamicResource PanelBrush}" CornerRadius="24" Padding="20" Margin="0,0,0,14" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"><StackPanel>
<TextBlock Text="💧  Νερό σήμερα" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/><TextBlock x:Name="WaterText" FontSize="28" FontWeight="SemiBold" Foreground="#2BA78E" Margin="0,12,0,10"/><ProgressBar x:Name="WaterProgress" Minimum="0" Maximum="100" Height="9" Margin="0,0,0,14"/><WrapPanel><Button Content="+ 250 ml" Click="Water250_Click"/><Button Content="+ 500 ml" Click="Water500_Click"/><Button Content="− 250 ml" Click="WaterMinus_Click"/></WrapPanel></StackPanel></Border>
<Border Background="{DynamicResource GoalCardBrush}" CornerRadius="22" Padding="20" BorderBrush="{DynamicResource GoalCardBorderBrush}" BorderThickness="1"><StackPanel><TextBlock Text="Η σημερινή πρόοδος" FontSize="19" FontWeight="SemiBold" Foreground="#284739"/><TextBlock x:Name="GoalInsight" TextWrapping="Wrap" Foreground="#496A5C" Margin="0,10,0,0"/></StackPanel></Border>
</StackPanel></Grid>
<StackPanel x:Name="DiaryPanel" Visibility="Collapsed">
<Border Background="#258F7C" CornerRadius="22" Padding="22" Margin="0,0,0,12" MinHeight="126">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel VerticalAlignment="Center"><TextBlock Text="Η διατροφή σου, οργανωμένη" FontSize="28" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Προγραμμάτισε, κατέγραψε και παρακολούθησε τη διατροφή σου." Foreground="#F1FFF9" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel>
<TextBlock Grid.Column="1" Text="🥗  🍽" FontSize="42" VerticalAlignment="Center" Margin="20,0,0,0"/></Grid></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="20" Padding="20" Margin="0,0,12,0">
<StackPanel>
<Button Content="+ Νέο γεύμα" Background="#2FA98D" Foreground="White" HorizontalAlignment="Left" Click="OpenEntryEditor_Click" Margin="0,0,0,14"/><TextBlock Text="Ημερήσιες καταχωρίσεις" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,12"/><TextBlock Text="Διάλεξε καταχώριση για επεξεργασία ή πρόσθεσε νέο γεύμα." FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/><Expander x:Name="EntryEditor" Header="+ Προσθήκη ή επεξεργασία τροφίμου" IsExpanded="False" Margin="0,0,0,12"><StackPanel Margin="0,14,0,8">
<TextBlock Text="Γεύμα" Foreground="{DynamicResource MutedBrush}"/>
<ComboBox x:Name="MealPicker" Margin="0,5,0,14" SelectedIndex="0"><ComboBoxItem Content="Πρωινό"/><ComboBoxItem Content="Δεκατιανό"/><ComboBoxItem Content="Μεσημεριανό"/><ComboBoxItem Content="Απογευματινό"/><ComboBoxItem Content="Βραδινό"/></ComboBox>
<TextBlock Text="Αναζήτηση τροφίμου" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="FoodSearch" TextChanged="FoodSearch_Changed" Margin="0,5,0,10"/>
<TextBlock Text="Τρόφιμο" Foreground="{DynamicResource MutedBrush}"/><ComboBox x:Name="FoodPicker" DisplayMemberPath="Name" Margin="0,5,0,14"/>
<TextBlock Text="Ποσότητα (γραμμάρια)" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="GramsInput" Text="100" Margin="0,5,0,14"/>
<WrapPanel><Button Content="+ Καταχώριση" Click="SaveEntry_Click" Background="#2FA98D" Foreground="White"/><Button Content="Ενημέρωση" Click="UpdateEntry_Click"/><Button Content="Καθαρισμός" Click="ClearEntry_Click"/><Button Content="Αντιγραφή χθεσινών" Click="CopyYesterday_Click"/></WrapPanel>
</StackPanel></Expander><TextBlock Text="Καταχωρίσεις ημέρας" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,10"/>
<ItemsControl x:Name="MealGroups" Margin="0,0,0,10">
<ItemsControl.ItemTemplate><DataTemplate>
<Expander IsExpanded="True" Margin="0,0,0,10">
<Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontSize="20" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource InkBrush}"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" Margin="10,2,0,0" FontSize="12"/></StackPanel></Expander.Header>
<StackPanel Margin="4,8,0,2">
<ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate>
<Border Background="{DynamicResource BackgroundBrush}" CornerRadius="10" Padding="9" Margin="0,0,0,5">
<StackPanel><TextBlock Text="{Binding Name}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
<TextBlock Text="{Binding Details}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,7"/>
<WrapPanel><Button Content="Επεξεργασία" Tag="{Binding Id}" Click="MealRowEdit_Click" FontSize="11" Padding="8,5"/><Button Content="Διαγραφή" Tag="{Binding Id}" Click="MealRowDelete_Click" FontSize="11" Padding="8,5"/></WrapPanel></StackPanel>
</Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="Χωρίς καταχωρίσεις" Visibility="{Binding EmptyVisibility}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,10"/>
<Button Content="+ Προσθήκη στο γεύμα" Tag="{Binding Name}" Click="MealGroupAdd_Click" HorizontalAlignment="Left" FontSize="11" Padding="9,5"/>
</StackPanel></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="Αντιγραφή συγκεκριμένου γεύματος" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,6"/>
<TextBlock Text="Επίλεξε ημερομηνία προέλευσης και γεύμα. Η αντιγραφή προσθέτει καταχωρίσεις στην επιλεγμένη ημέρα." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
<DatePicker x:Name="CopyMealSourceDay" Margin="0,0,0,7"/>
<ComboBox x:Name="CopyMealPicker" SelectedIndex="0" Margin="0,0,0,8"><ComboBoxItem Content="Πρωινό"/><ComboBoxItem Content="Δεκατιανό"/><ComboBoxItem Content="Μεσημεριανό"/><ComboBoxItem Content="Απογευματινό"/><ComboBoxItem Content="Βραδινό"/></ComboBox>
<Button Content="Αντιγραφή γεύματος" Click="CopySelectedMeal_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/>
<ListBox x:Name="EntriesList" SelectionChanged="EntriesList_SelectionChanged" Height="90" Visibility="Collapsed" FontSize="14" Padding="10" BorderThickness="0" Background="{DynamicResource PanelBrush}" DisplayMemberPath="Food"/>
<Button Content="Διαγραφή επιλεγμένης" HorizontalAlignment="Left" Margin="0,10,0,0" Click="DeleteEntry_Click"/>
<Expander Header="+ Προσωπικό τρόφιμο (ανά 100 g)" Margin="0,22,0,0"><StackPanel Margin="0,12,0,0"><TextBox x:Name="CustomFoodName" Margin="0,0,0,8"/><UniformGrid Columns="4"><TextBox x:Name="CustomKcal" ToolTip="Θερμίδες" Text="0"/><TextBox x:Name="CustomProtein" ToolTip="Πρωτεΐνη" Text="0"/><TextBox x:Name="CustomCarbs" ToolTip="Υδατάνθρακες" Text="0"/><TextBox x:Name="CustomFat" ToolTip="Λίπος" Text="0"/></UniformGrid><TextBlock Text="kcal · πρωτεΐνη · υδατάνθρακες · λίπος" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,8" TextWrapping="Wrap"/><Button Content="Αποθήκευση τροφίμου" HorizontalAlignment="Left" Click="AddFood_Click"/></StackPanel></Expander>
</StackPanel></Border>
<StackPanel Grid.Column="1" Margin="0,0,12,0">
<Border Background="{DynamicResource DinnerBrush}" CornerRadius="18" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="ΗΜΕΡΗΣΙΑ ΠΡΟΟΔΟΣ" FontSize="12" FontWeight="SemiBold" Foreground="#866E58"/><TextBlock Text="Το πιάτο της ημέρας" Margin="0,7,0,0" FontSize="19" FontWeight="SemiBold" Foreground="#4B4034"/><TextBlock x:Name="DiaryDailyTotal" FontSize="29" FontWeight="Bold" Foreground="#2D554B" Margin="0,10,0,6"/><TextBlock x:Name="DiaryDailyRemaining" Foreground="#5B685F" TextWrapping="Wrap"/><ProgressBar x:Name="DiaryCalorieProgress" Minimum="0" Maximum="100" Height="8" Margin="0,12,0,0"/></StackPanel></Border>
<Border Background="#DDF3F7" CornerRadius="18" Padding="15" BorderBrush="#C0E3E8" BorderThickness="1" Margin="0,0,0,12"><StackPanel><TextBlock Text="🥣" FontSize="40" HorizontalAlignment="Right" Margin="0,0,0,-36"/><TextBlock Text="Πρωινό" FontSize="18" FontWeight="SemiBold" Foreground="#244D58"/><TextBlock x:Name="DiaryBreakfast" FontSize="22" Foreground="#244D58" Margin="0,8,0,0"/><TextBlock Text="ΠΡΩΙΝΟ ΓΕΥΜΑ" FontSize="10" Foreground="#416D78" Margin="0,9,0,0"/><TextBlock x:Name="DiaryBreakfastFoods" TextWrapping="Wrap" FontSize="12" Foreground="#416D78" Margin="0,9,0,0"/></StackPanel></Border>
<Border Background="{DynamicResource LunchBrush}" CornerRadius="18" Padding="15" BorderBrush="#D2E8B6" BorderThickness="1" Margin="0,0,0,12"><StackPanel><TextBlock Text="🥗" FontSize="40" HorizontalAlignment="Right" Margin="0,0,0,-36"/><TextBlock Text="Μεσημεριανό" FontSize="18" FontWeight="SemiBold" Foreground="#40502B"/><TextBlock x:Name="DiaryLunch" FontSize="22" Foreground="#40502B" Margin="0,8,0,0"/><TextBlock Text="ΜΕΣΗΜΕΡΙΑΝΟ ΓΕΥΜΑ" FontSize="10" Foreground="#5D7540" Margin="0,9,0,0"/><TextBlock x:Name="DiaryLunchFoods" TextWrapping="Wrap" FontSize="12" Foreground="#5D7540" Margin="0,9,0,0"/></StackPanel></Border>
<Border Background="#FFF0DF" CornerRadius="18" Padding="15" BorderBrush="#EFD8C2" BorderThickness="1" Margin="0,0,0,12"><StackPanel><TextBlock Text="🍲" FontSize="40" HorizontalAlignment="Right" Margin="0,0,0,-36"/><TextBlock Text="Βραδινό" FontSize="18" FontWeight="SemiBold" Foreground="#5A4336"/><TextBlock x:Name="DiaryDinner" FontSize="22" Foreground="#5A4336" Margin="0,8,0,0"/><TextBlock Text="ΒΡΑΔΙΝΟ ΓΕΥΜΑ" FontSize="10" Foreground="#876A50" Margin="0,9,0,0"/><TextBlock x:Name="DiaryDinnerFoods" TextWrapping="Wrap" FontSize="12" Foreground="#876A50" Margin="0,9,0,0"/></StackPanel></Border>
<Border Background="{DynamicResource PanelBrush}" CornerRadius="18" Padding="17"><StackPanel><TextBlock Text="🍎" FontSize="36" HorizontalAlignment="Right" Margin="0,0,0,-32"/><TextBlock Text="Ενδιάμεσα γεύματα" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/><TextBlock x:Name="DiarySnacks" FontSize="21" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0"/><TextBlock x:Name="DiarySnackFoods" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0"/></StackPanel></Border>
</StackPanel>
<StackPanel Grid.Column="2">
<Border Background="{DynamicResource PanelBrush}" CornerRadius="18" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="💧  Ενυδάτωση" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/><TextBlock x:Name="DiaryWater" FontSize="26" FontWeight="SemiBold" Foreground="#2BA78E" Margin="0,14,0,10"/><ProgressBar x:Name="DiaryWaterProgress" Height="9" Minimum="0" Maximum="100"/><TextBlock x:Name="DiaryWaterGoalLabel" Text="Στόχος: 2.000 ml" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,9,0,12" TextWrapping="Wrap"/><WrapPanel><Button Content="+250 ml" Click="Water250_Click"/><Button Content="+500 ml" Click="Water500_Click"/></WrapPanel></StackPanel></Border>
<Border Background="#E3F4E9" CornerRadius="18" Padding="18"><StackPanel><TextBlock Text="Ημερήσια σύνοψη" FontSize="18" FontWeight="SemiBold" Foreground="#284739"/><TextBlock x:Name="DiaryMacroSummary" TextWrapping="Wrap" Foreground="#496A5C" Margin="0,12,0,10"/>
<TextBlock x:Name="ProteinGoalStatus" Foreground="#284739" Margin="0,7,0,3"/><ProgressBar x:Name="ProteinGoalProgress" Height="7" Maximum="100"/>
<TextBlock x:Name="CarbGoalStatus" Foreground="#284739" Margin="0,10,0,3"/><ProgressBar x:Name="CarbGoalProgress" Height="7" Maximum="100"/>
<TextBlock x:Name="FatGoalStatus" Foreground="#284739" Margin="0,10,0,3"/><ProgressBar x:Name="FatGoalProgress" Height="7" Maximum="100"/></StackPanel></Border>
</StackPanel>
</Grid></StackPanel>
<StackPanel x:Name="ReportsPanel" Visibility="Collapsed">
<Border Background="{DynamicResource HeroBrush}" CornerRadius="22" Padding="22" Margin="0,0,0,16" BorderBrush="{DynamicResource HeroBorderBrush}" BorderThickness="1">
<StackPanel><TextBlock Text="📊  Αναφορές διατροφής" FontSize="26" FontWeight="SemiBold" Foreground="#273F35"/><TextBlock Text="Παρακολούθησε την πορεία σου με βάση τις πραγματικές ημερήσιες καταχωρίσεις." Foreground="#365E4B" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
<Border Background="{DynamicResource PanelBrush}" CornerRadius="18" Padding="18" Margin="0,0,0,14" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
<StackPanel Orientation="Horizontal"><TextBlock Text="Περίοδος:" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
<Button Content="Ημέρα" Tag="day" Click="ReportRange_Click" Margin="0,0,7,0"/>
<Button Content="7 ημέρες" Tag="week" Click="ReportRange_Click" Margin="0,0,7,0"/>
<Button Content="30 ημέρες" Tag="month" Click="ReportRange_Click"/>
<TextBlock x:Name="ReportPeriodLabel" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="18,0,12,0"/><Button Content="Εξαγωγή CSV" Click="ExportReport_Click" ToolTip="Εξαγωγή της επιλεγμένης περιόδου σε CSV"/></StackPanel></Border>
<UniformGrid Columns="3" Margin="0,0,0,14">
<Border Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="18" Margin="0,0,8,0" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"><StackPanel><TextBlock Text="Μέσες θερμίδες / ημέρα" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ReportAverageCalories" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,10,0,0"/></StackPanel></Border>
<Border Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="18" Margin="4,0" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"><StackPanel><TextBlock Text="Ημέρες με καταχωρίσεις" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ReportLoggedDays" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,10,0,0"/></StackPanel></Border>
<Border Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="18" Margin="8,0,0,0" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"><StackPanel><TextBlock Text="Ημέρες εντός στόχου" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ReportGoalDays" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,10,0,0"/></StackPanel></Border>
</UniformGrid>
<Border Background="{DynamicResource PanelBrush}" CornerRadius="20" Padding="20" Margin="0,0,0,14" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
<StackPanel><TextBlock Text="Θερμίδες ανά ημέρα" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/><TextBlock x:Name="ReportChartHint" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,14" TextWrapping="Wrap"/>
<ItemsControl x:Name="ReportBars"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="12"/><Grid Grid.Column="1" Height="18" Background="{DynamicResource BackgroundBrush}"><Border Background="#51B69A" Width="{Binding Width}" HorizontalAlignment="Left" CornerRadius="4"/></Grid><TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{DynamicResource InkBrush}" TextAlignment="Right" FontSize="12" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></Border>
<Border Background="{DynamicResource PanelBrush}" CornerRadius="20" Padding="20" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
<StackPanel><TextBlock Text="Σύνοψη περιόδου" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/><TextBlock x:Name="ReportMacroText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock x:Name="ReportWaterText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
</StackPanel>
<StackPanel x:Name="FoodsPanel" Visibility="Collapsed">
<Border Background="{DynamicResource HeroBrush}" CornerRadius="22" Padding="22" Margin="0,0,0,16">
<StackPanel><TextBlock Text="Βιβλιοθήκη τροφίμων" FontSize="26" FontWeight="Bold" Foreground="#273F35"/>
<TextBlock Text="Αναζήτησε τρόφιμα, αποθήκευσε αγαπημένα και πρόσθεσε γρήγορα στο ημερολόγιο." Foreground="#365E4B" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="20" Padding="20" Margin="0,0,12,0" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
<StackPanel><TextBlock Text="Αναζήτηση τροφίμων" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
<TextBox x:Name="LibrarySearch" Margin="0,12,0,12" TextChanged="LibrarySearch_Changed" ToolTip="Αναζήτηση με όνομα"/>
<WrapPanel Margin="0,0,0,12"><Button Content="Όλα" Tag="all" Click="LibraryFilter_Click"/><Button Content="★ Αγαπημένα" Tag="favorites" Click="LibraryFilter_Click"/><Button Content="Πρόσφατα" Tag="recent" Click="LibraryFilter_Click"/></WrapPanel>
<TextBlock x:Name="LibraryCount" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
<ListBox x:Name="LibraryFoods" Height="430" SelectionChanged="LibraryFoods_SelectionChanged" DisplayMemberPath="Name"/>
</StackPanel></Border>
<Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="20" Padding="20" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
<StackPanel><TextBlock Text="Στοιχεία τροφίμου (ανά 100 g)" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
<TextBlock Text="Όνομα" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,4"/><TextBox x:Name="LibraryName" MaxLength="100"/>
<TextBlock Text="Θερμίδες (kcal)" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,4"/><TextBox x:Name="LibraryKcal"/>
<TextBlock Text="Πρωτεΐνη (g)" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,4"/><TextBox x:Name="LibraryProtein"/>
<TextBlock Text="Υδατάνθρακες (g)" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,4"/><TextBox x:Name="LibraryCarbs"/>
<TextBlock Text="Λίπος (g)" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,4"/><TextBox x:Name="LibraryFat"/>
<WrapPanel Margin="0,14,0,0"><Button Content="★ Αγαπημένο" Click="LibraryFavorite_Click"/><Button Content="Νέο" Click="LibraryNew_Click"/><Button Content="Αποθήκευση" Click="LibrarySave_Click" Background="#2FA98D" Foreground="White"/></WrapPanel>
<TextBlock Text="Προσθήκη στο ημερολόγιο" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,20,0,10"/>
<ComboBox x:Name="LibraryMeal" SelectedIndex="0" Margin="0,0,0,8"><ComboBoxItem Content="Πρωινό"/><ComboBoxItem Content="Δεκατιανό"/><ComboBoxItem Content="Μεσημεριανό"/><ComboBoxItem Content="Απογευματινό"/><ComboBoxItem Content="Βραδινό"/></ComboBox>
<TextBox x:Name="LibraryGrams" Text="100" Margin="0,0,0,10" ToolTip="Ποσότητα σε γραμμάρια"/>
<Button Content="+ Προσθήκη στο ημερολόγιο" Click="LibraryAdd_Click" Background="#2FA98D" Foreground="White" HorizontalAlignment="Left"/>
</StackPanel></Border></Grid></StackPanel>
<StackPanel x:Name="ProfilesPanel" Visibility="Collapsed">
<Border Background="White" CornerRadius="18" Padding="24">
<StackPanel>
<TextBlock Text="Νέο προφίλ" FontSize="20" FontWeight="SemiBold" Foreground="#173D35"/>
<TextBox x:Name="NewProfileName" Margin="0,12,0,12" MaxLength="60"/>
<Button Content="Δημιουργία προφίλ" HorizontalAlignment="Left" Click="AddProfile_Click"/>
<TextBlock Text="Μετονομασία επιλεγμένου προφίλ" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,22,0,8"/><TextBox x:Name="RenameInput" Margin="0,0,0,8"/><Button Content="Αποθήκευση ονόματος" HorizontalAlignment="Left" Click="Rename_Click"/><TextBlock Text="Ημερήσιος στόχος θερμίδων" FontSize="20" FontWeight="SemiBold" Foreground="#173D35" Margin="0,25,0,8"/>
<TextBox x:Name="GoalInput" Margin="0,0,0,12"/>
<Button Content="Αποθήκευση στόχου" HorizontalAlignment="Left" Click="SaveGoal_Click"/>
<TextBlock Text="Στόχοι μακροθρεπτικών και νερού" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,24,0,12"/>
<TextBlock Text="Πρωτεΐνη (g / ημέρα)" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="ProteinGoalInput" Margin="0,5,0,10"/>
<TextBlock Text="Υδατάνθρακες (g / ημέρα)" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="CarbGoalInput" Margin="0,5,0,10"/>
<TextBlock Text="Λιπαρά (g / ημέρα)" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="FatGoalInput" Margin="0,5,0,10"/>
<TextBlock Text="Νερό (ml / ημέρα)" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="WaterGoalInput" Margin="0,5,0,12"/>
<Button Content="Αποθήκευση διατροφικών στόχων" HorizontalAlignment="Left" Background="#2FA98D" Foreground="White" Click="SaveNutritionGoals_Click"/>
<Button Content="Αντίγραφο ασφαλείας δεδομένων (.db)" Click="Backup_Click" HorizontalAlignment="Left" Margin="0,24,0,0" ToolTip="Ασφαλής εξαγωγή της τοπικής βάσης SQLite"/><TextBlock Text="Οι στόχοι είναι ενδεικτικές προσωπικές ρυθμίσεις και δεν υπολογίζονται αυτόματα ως ιατρική σύσταση." Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
</StackPanel>
</Border>
</StackPanel>
<StackPanel x:Name="WeightPanel" Visibility="Collapsed" HorizontalAlignment="Center" Width="880"><Border Background="#EAF5F1" CornerRadius="22" Padding="30"><StackPanel><TextBlock Text="ΠΑΡΑΚΟΛΟΥΘΗΣΗ ΒΑΡΟΥΣ" FontSize="13" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="Συνέχισε την πρόοδό σου" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/><TextBlock x:Name="LatestWeightText" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource InkBrush}" Margin="0,18,0,0"/><TextBlock x:Name="WeightDeltaText" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="WeightProgressText" HorizontalAlignment="Center" Foreground="#278B6C" FontWeight="SemiBold" Margin="0,8,0,0"/><Canvas x:Name="WeightChart" Height="245" Margin="10,22,10,16" Background="Transparent" SizeChanged="WeightChart_SizeChanged"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18"><Button x:Name="Range7" Content="1W" Tag="7" Click="WeightRange_Click"/><Button x:Name="Range30" Content="1M" Tag="30" Click="WeightRange_Click"/><Button x:Name="Range90" Content="3M" Tag="90" Click="WeightRange_Click"/><Button x:Name="Range180" Content="6M" Tag="180" Click="WeightRange_Click"/><Button x:Name="Range365" Content="1Y" Tag="365" Click="WeightRange_Click"/><Button x:Name="RangeAll" Content="All" Tag="0" Click="WeightRange_Click"/></StackPanel><TextBlock x:Name="WeightAxisLabel" Text="Βάρος (kg) · ημερομηνία" HorizontalAlignment="Center" Foreground="#527567" Margin="0,0,0,7"/><TextBlock x:Name="WeightRangeLabel" Text="Όλες οι διαθέσιμες μετρήσεις" HorizontalAlignment="Center" Foreground="#527567" Margin="0,0,0,18"/><TextBlock Text="Καταγραφή βάρους (kg)" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/><TextBox x:Name="WeightInput" Margin="0,12,0,12"/><Button Content="Αποθήκευση βάρους" HorizontalAlignment="Left" Click="SaveWeight_Click"/><TextBlock Text="Πρόσφατες μετρήσεις" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,20,0,10"/><ListBox x:Name="WeightsList" Height="250"/></StackPanel></Border></StackPanel>
</StackPanel>
</ScrollViewer>
</Grid>
</Window>