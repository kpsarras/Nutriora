<Window x:Class="Nutriora.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nutriora — Nutrition &amp; Fitness" Width="1320" Height="860" MinWidth="980" MinHeight="680" Background="{DynamicResource BackgroundBrush}" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#252B32" CornerRadius="0,24,24,0">
<StackPanel Margin="12,22">
<TextBlock Text="N" FontWeight="Bold" FontSize="30" Foreground="#BFE6A0" HorizontalAlignment="Center" Margin="0,0,0,35"/>
<Button Content="⌂" FontSize="23" ToolTip="Dashboard" Click="Dashboard_Click"/>
<Button Content="☷" FontSize="23" ToolTip="Ημερολόγιο" Click="Diary_Click" Margin="0,14,0,0"/>
<Button Content="◉" FontSize="23" ToolTip="Προφίλ και στόχοι" Click="Profiles_Click" Margin="0,14,0,0"/><Button Content="⚖" FontSize="23" ToolTip="Βάρος" Click="Weight_Click" Margin="0,14,0,0"/><Button Content="☼" FontSize="23" ToolTip="Εναλλαγή θέματος" Click="Theme_Click" Margin="0,14,0,0"/>
</StackPanel>
</Border>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
<StackPanel Margin="26,24">
<DockPanel Margin="0,0,0,20">
<TextBlock x:Name="PageTitle" Text="Η σημερινή σου εικόνα" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
<TextBlock Text="Nutriora · alpha.5" Foreground="#60786F" HorizontalAlignment="Right" VerticalAlignment="Center"/>
</DockPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,0,18">
<TextBlock Text="Προφίλ:" VerticalAlignment="Center" Foreground="#173D35" Margin="0,0,10,0"/>
<ComboBox x:Name="ProfilePicker" Width="200" DisplayMemberPath="Name" SelectionChanged="Profile_Changed"/>
<TextBlock Text="Ημερομηνία:" Margin="22,0,10,0" VerticalAlignment="Center" Foreground="#173D35"/>
<DatePicker x:Name="DayPicker" SelectedDateChanged="Day_Changed"/>
</StackPanel>
<Grid x:Name="DashboardPanel">
<Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Margin="0,0,10,0">
<Border Background="#CFEAB7" CornerRadius="24" Padding="22" Margin="0,0,0,14" MinHeight="150">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel VerticalAlignment="Center"><TextBlock Text="Η πρόοδός σου, κάθε μέρα." FontSize="26" FontWeight="Bold" Foreground="#27342A" TextWrapping="Wrap"/><TextBlock Text="Μικρές συνήθειες, μεγάλη διαφορά!" FontSize="14" Foreground="#455A43" Margin="0,9,0,0"/></StackPanel>
<TextBlock Grid.Column="1" Text="🥗" FontSize="56" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid></Border>
<Border Background="#252B32" CornerRadius="24" Padding="22" Margin="0,0,0,14" Height="152">
<StackPanel><TextBlock Text="Ημερήσια δραστηριότητα" FontSize="20" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="Οι καταγραφές σου με μια ματιά" Foreground="#AFC0BB" Margin="0,8,0,10"/><TextBlock x:Name="ActivitySummary" FontSize="25" Foreground="#CDEB83" FontWeight="SemiBold"/></StackPanel></Border>
<Border Background="{DynamicResource PanelBrush}" CornerRadius="22" Padding="20" Margin="0,0,0,14">
<StackPanel><TextBlock Text="Ημερήσια ανασκόπηση" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/><TextBlock x:Name="CaloriesText" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,10,0,8"/><ProgressBar x:Name="CaloriesProgress" Height="9" Minimum="0" Maximum="100" Margin="0,0,0,10"/><TextBlock x:Name="MacroText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
<UniformGrid Columns="3"><Border Background="#D8F0F8" CornerRadius="14" Padding="12" Margin="0,0,6,0"><StackPanel><TextBlock Text="Υδατάνθρακες" FontSize="11" Foreground="#33434A"/><TextBlock x:Name="CarbValue" FontSize="20" FontWeight="Bold" Foreground="#273A45"/></StackPanel></Border><Border Background="#FFF0C8" CornerRadius="14" Padding="12" Margin="3,0"><StackPanel><TextBlock Text="Πρωτεΐνη" FontSize="11" Foreground="#5B4B27"/><TextBlock x:Name="ProteinValue" FontSize="20" FontWeight="Bold" Foreground="#5B4B27"/></StackPanel></Border><Border Background="#E3F4C6" CornerRadius="14" Padding="12" Margin="6,0,0,0"><StackPanel><TextBlock Text="Λίπος" FontSize="11" Foreground="#35553C"/><TextBlock x:Name="FatValue" FontSize="20" FontWeight="Bold" Foreground="#35553C"/></StackPanel></Border></UniformGrid></StackPanel></Border>
<Border Background="{DynamicResource PanelBrush}" CornerRadius="22" Padding="20"><StackPanel>
<TextBlock Text="Ημερήσια γεύματα" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,10"/>
<UniformGrid Columns="3"><Border Background="#DDF3F7" CornerRadius="16" Padding="12" Margin="0,0,6,0"><StackPanel><TextBlock Text="Πρωινό" Foreground="#244D58"/><TextBlock x:Name="BreakfastCalories" FontSize="18" Foreground="#244D58" Margin="0,8,0,0"/></StackPanel></Border><Border Background="#E9F8CE" CornerRadius="16" Padding="12" Margin="3,0"><StackPanel><TextBlock Text="Μεσημεριανό" Foreground="#40502B"/><TextBlock x:Name="LunchCalories" FontSize="18" Foreground="#40502B" Margin="0,8,0,0"/></StackPanel></Border><Border Background="#FFF0DF" CornerRadius="16" Padding="12" Margin="6,0,0,0"><StackPanel><TextBlock Text="Βραδινό" Foreground="#5A4336"/><TextBlock x:Name="DinnerCalories" FontSize="18" Foreground="#5A4336" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid>
<TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
<Button Content="+ Προσθήκη τροφίμου" Click="Diary_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
</StackPanel>
<StackPanel Grid.Column="1" Margin="10,0,0,0">
<Border Background="{DynamicResource PanelBrush}" CornerRadius="24" Padding="22" Margin="0,0,0,14">
<StackPanel><TextBlock Text="Προϋπολογισμός θερμίδων" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
<Grid Width="190" Height="190" HorizontalAlignment="Center" Margin="0,12"><Ellipse Stroke="#E1E9D9" StrokeThickness="18" Margin="15"/><Path x:Name="BudgetArc" Stroke="#A2D8B6" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="BudgetPercentText" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center"/><TextBlock Text="ημερήσιος στόχος" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Grid>
<ProgressBar x:Name="BudgetProgress" Minimum="0" Maximum="100" Height="7" Visibility="Collapsed"/><TextBlock x:Name="BudgetRemainingText" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/></StackPanel></Border>
<Border Background="{DynamicResource PanelBrush}" CornerRadius="24" Padding="20" Margin="0,0,0,14"><StackPanel>
<TextBlock Text="💧  Νερό σήμερα" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/><TextBlock x:Name="WaterText" FontSize="28" FontWeight="SemiBold" Foreground="#2BA78E" Margin="0,12,0,10"/><ProgressBar x:Name="WaterProgress" Minimum="0" Maximum="100" Height="9" Margin="0,0,0,14"/><WrapPanel><Button Content="+ 250 ml" Click="Water250_Click"/><Button Content="+ 500 ml" Click="Water500_Click"/><Button Content="− 250 ml" Click="WaterMinus_Click"/></WrapPanel></StackPanel></Border>
<Border Background="#E2F2E6" CornerRadius="22" Padding="20"><StackPanel><TextBlock Text="Στόχοι ημέρας" FontSize="19" FontWeight="SemiBold" Foreground="#284739"/><TextBlock Text="Η συνέπεια μετρά περισσότερο από την τελειότητα." TextWrapping="Wrap" Foreground="#496A5C" Margin="0,10,0,0"/></StackPanel></Border>
</StackPanel></Grid>
<StackPanel x:Name="DiaryPanel" Visibility="Collapsed"><Border Background="#2FA98D" CornerRadius="22" Padding="25" Margin="0,0,0,16"><StackPanel><TextBlock Text="Οργάνωσε τα καθημερινά σου γεύματα" FontSize="28" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="🥗  🍲  🥑     Κατέγραψε τα τρόφιμα και παρακολούθησε τις θερμίδες σου." Foreground="#F1FFF9" Margin="0,12,0,0"/></StackPanel></Border>
<Border Background="{DynamicResource PanelBrush}" CornerRadius="18" Padding="24" MaxWidth="850" HorizontalAlignment="Left">
<StackPanel>
<TextBlock Text="Προσθήκη τροφίμου" FontSize="21" FontWeight="SemiBold" Foreground="#173D35" Margin="0,0,0,16"/>
<TextBlock Text="Γεύμα" Foreground="#60786F"/>
<ComboBox x:Name="MealPicker" Margin="0,5,0,14" SelectedIndex="0">
<ComboBoxItem Content="Πρωινό"/><ComboBoxItem Content="Δεκατιανό"/><ComboBoxItem Content="Μεσημεριανό"/><ComboBoxItem Content="Απογευματινό"/><ComboBoxItem Content="Βραδινό"/>
</ComboBox>
<TextBlock Text="Αναζήτηση τροφίμου" Foreground="#60786F"/><TextBox x:Name="FoodSearch" TextChanged="FoodSearch_Changed" Margin="0,5,0,10"/><TextBlock Text="Τρόφιμο" Foreground="#60786F"/>
<ComboBox x:Name="FoodPicker" DisplayMemberPath="Name" Margin="0,5,0,14"/>
<TextBlock Text="Ποσότητα (γραμμάρια)" Foreground="#60786F"/>
<TextBox x:Name="GramsInput" Text="100" Margin="0,5,0,14"/>
<StackPanel Orientation="Horizontal"><Button Content="Καταχώριση" Width="145" Click="SaveEntry_Click"/><Button Content="Ενημέρωση επιλεγμένου" Click="UpdateEntry_Click"/><Button Content="Αντιγραφή από χθες" Click="CopyYesterday_Click"/></StackPanel>
<TextBlock Text="Καταχωρίσεις επιλεγμένης ημέρας" FontSize="19" FontWeight="SemiBold" Foreground="#173D35" Margin="0,24,0,10"/>
<ListBox x:Name="EntriesList" Height="230" DisplayMemberPath="Food" FontSize="14" Padding="8"/>
<Button Content="Διαγραφή επιλεγμένης καταχώρισης" HorizontalAlignment="Left" Margin="0,10,0,0" Click="DeleteEntry_Click"/><TextBlock Text="Προσθήκη προσωπικού τροφίμου (ανά 100 g)" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,22,0,8"/><TextBox x:Name="CustomFoodName" Margin="0,0,0,8"/><UniformGrid Columns="4"><TextBox x:Name="CustomKcal" ToolTip="Θερμίδες" Text="0"/><TextBox x:Name="CustomProtein" ToolTip="Πρωτεΐνη" Text="0"/><TextBox x:Name="CustomCarbs" ToolTip="Υδατάνθρακες" Text="0"/><TextBox x:Name="CustomFat" ToolTip="Λίπος" Text="0"/></UniformGrid><TextBlock Text="Πεδία: θερμίδες · πρωτεΐνη · υδατάνθρακες · λίπος" Foreground="#60786F" Margin="0,8,0,8"/><Button Content="+ Αποθήκευση τροφίμου" HorizontalAlignment="Left" Click="AddFood_Click"/>
</StackPanel>
</Border>
</StackPanel>
<StackPanel x:Name="ProfilesPanel" Visibility="Collapsed">
<Border Background="White" CornerRadius="18" Padding="24">
<StackPanel>
<TextBlock Text="Νέο προφίλ" FontSize="20" FontWeight="SemiBold" Foreground="#173D35"/>
<TextBox x:Name="NewProfileName" Margin="0,12,0,12" MaxLength="60"/>
<Button Content="Δημιουργία προφίλ" HorizontalAlignment="Left" Click="AddProfile_Click"/>
<TextBlock Text="Μετονομασία επιλεγμένου προφίλ" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,22,0,8"/><TextBox x:Name="RenameInput" Margin="0,0,0,8"/><Button Content="Αποθήκευση ονόματος" HorizontalAlignment="Left" Click="Rename_Click"/><TextBlock Text="Ημερήσιος στόχος θερμίδων" FontSize="20" FontWeight="SemiBold" Foreground="#173D35" Margin="0,25,0,8"/>
<TextBox x:Name="GoalInput" Margin="0,0,0,12"/>
<Button Content="Αποθήκευση στόχου" HorizontalAlignment="Left" Click="SaveGoal_Click"/>
<TextBlock Text="Οι θερμιδικοί στόχοι ορίζονται χειροκίνητα στην παρούσα έκδοση." Foreground="#60786F" Margin="0,18,0,0" TextWrapping="Wrap"/>
</StackPanel>
</Border>
</StackPanel>
<StackPanel x:Name="WeightPanel" Visibility="Collapsed" HorizontalAlignment="Center" Width="720"><Border Background="{DynamicResource PanelBrush}" CornerRadius="22" Padding="30"><StackPanel><TextBlock Text="TRACKING" FontSize="13" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="Συνέχισε την πρόοδό σου" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/><TextBlock x:Name="LatestWeightText" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource InkBrush}" Margin="0,18,0,0"/><TextBlock x:Name="WeightDeltaText" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><Canvas x:Name="WeightChart" Height="210" Margin="10,22,10,16" Background="Transparent" SizeChanged="WeightChart_SizeChanged"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18"><Button Content="1W" Tag="7" Click="WeightRange_Click"/><Button Content="1M" Tag="30" Click="WeightRange_Click"/><Button Content="3M" Tag="90" Click="WeightRange_Click"/><Button Content="6M" Tag="180" Click="WeightRange_Click"/><Button Content="1Y" Tag="365" Click="WeightRange_Click"/><Button Content="All" Tag="0" Click="WeightRange_Click"/></StackPanel><TextBlock Text="Καταγραφή βάρους (kg)" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/><TextBox x:Name="WeightInput" Margin="0,12,0,12"/><Button Content="Αποθήκευση βάρους" HorizontalAlignment="Left" Click="SaveWeight_Click"/><TextBlock Text="Πρόσφατες μετρήσεις" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,20,0,10"/><ListBox x:Name="WeightsList" Height="250"/></StackPanel></Border></StackPanel>
</StackPanel>
</ScrollViewer>
</Grid>
</Window>