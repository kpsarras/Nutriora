<Window x:Class="Nutriora.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nutriora — Nutrition &amp; Fitness" Width="1200" Height="800" MinWidth="850" MinHeight="600" Background="{DynamicResource BackgroundBrush}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#173D35" CornerRadius="0,20,20,0">
      <StackPanel Margin="12,24">
        <TextBlock Text="✦" Foreground="#C9E7D5" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,40"/>
        <Button Content="⌂" FontSize="24" ToolTip="Dashboard" Click="Dashboard_Click"/>
        <Button Content="☷" FontSize="24" ToolTip="Ημερολόγιο διατροφής" Click="Diary_Click" Margin="0,14,0,0"/>
        <Button Content="⚙" FontSize="24" ToolTip="Ρυθμίσεις" Click="Settings_Click" Margin="0,14,0,0"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="36,28">
        <DockPanel Margin="0,0,0,25">
          <TextBlock x:Name="PageTitle" Text="Η σημερινή σου εικόνα" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" DockPanel.Dock="Left"/>
          <TextBlock Text="Nutriora Studio · v0.1.0-alpha.1" FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Background="#E5F2E8" CornerRadius="22" Padding="26" Margin="0,0,0,18">
          <StackPanel>
            <TextBlock Text="ΗΜΕΡΗΣΙΑ ΠΡΟΟΔΟΣ" Foreground="#355C4D" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock x:Name="CaloriesText" Text="Δεν υπάρχουν καταχωρίσεις" FontSize="28" FontWeight="SemiBold" Foreground="#173D35" Margin="0,15,0,8"/>
            <TextBlock Text="Τα στοιχεία θα ενημερώνονται από το ημερολόγιο διατροφής." Foreground="#355C4D"/>
          </StackPanel>
        </Border>
        <UniformGrid Columns="2" Margin="0,0,0,18">
          <Border Background="White" CornerRadius="18" Padding="24" Margin="0,0,9,0"><StackPanel><TextBlock Text="Νερό" Foreground="#60786F" FontSize="15"/><TextBlock Text="Χωρίς καταγραφή" FontSize="20" FontWeight="SemiBold" Foreground="#173D35" Margin="0,10,0,0"/></StackPanel></Border>
          <Border Background="White" CornerRadius="18" Padding="24" Margin="9,0,0,0"><StackPanel><TextBlock Text="Άσκηση" Foreground="#60786F" FontSize="15"/><TextBlock Text="Χωρίς καταγραφή" FontSize="20" FontWeight="SemiBold" Foreground="#173D35" Margin="0,10,0,0"/></StackPanel></Border>
        </UniformGrid>
        <Border Background="White" CornerRadius="18" Padding="24">
          <StackPanel>
            <TextBlock Text="Σημερινά γεύματα" FontSize="21" FontWeight="SemiBold" Foreground="#173D35" Margin="0,0,0,15"/>
            <TextBlock x:Name="DiaryText" Text="Δεν έχουν καταχωριστεί γεύματα." Foreground="#60786F" Margin="0,0,0,14"/>
            <Button Content="+ Προσθήκη γεύματος" Width="190" HorizontalAlignment="Left" Click="AddMeal_Click"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>